{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Model Analyze API v1 Response",
  "type": "object",
  "required": [
    "schema_version",
    "model_version",
    "count",
    "results"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "model_version": {
      "type": "string"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "schema_version",
          "request_id",
          "user_id",
          "model_version",
          "input",
          "sentiment",
          "event",
          "portrait_features",
          "proposal_view"
        ],
        "properties": {
          "schema_version": {
            "const": "v1"
          },
          "request_id": {
            "type": "string"
          },
          "user_id": {
            "type": "string"
          },
          "model_version": {
            "type": "string"
          },
          "input": {
            "type": "object",
            "required": [
              "text",
              "event_bio_source"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "event_bio_source": {
                "type": "string",
                "enum": [
                  "provided",
                  "auto_rule_v1",
                  "model_v2",
                  "model_v2_rule_fallback",
                  "model_v2_low_confidence",
                  "model_v2_rejected_low_confidence"
                ]
              }
            }
          },
          "sentiment": {
            "type": "object",
            "required": [
              "label",
              "label_name",
              "confidence",
              "probabilities"
            ],
            "properties": {
              "label": {
                "type": "integer"
              },
              "label_name": {
                "type": "string"
              },
              "confidence": {
                "type": "number"
              },
              "probabilities": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          },
          "event": {
            "type": "object",
            "required": [
              "primary_event_type",
              "entity_type_counts",
              "entity_mentions_by_type",
              "protagonist_mentions",
              "participant_mentions",
              "entities"
            ],
            "properties": {
              "primary_event_type": {
                "type": "string"
              },
              "entity_type_counts": {
                "type": "object",
                "additionalProperties": {
                  "type": "integer"
                }
              },
              "entity_mentions_by_type": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "protagonist_mentions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "participant_mentions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "entities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "text",
                    "start",
                    "end"
                  ],
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "text": {
                      "type": "string"
                    },
                    "normalized_text": {
                      "type": "string"
                    },
                    "time_text": {
                      "type": "string"
                    },
                    "time_normalized": {
                      "type": "string"
                    },
                    "time_kind": {
                      "type": "string"
                    },
                    "frequency": {
                      "type": "string"
                    },
                    "frequency_score": {
                      "type": "integer"
                    },
                    "frequency_evidence": {
                      "type": "string"
                    },
                    "intensity": {
                      "type": "string"
                    },
                    "intensity_score": {
                      "type": "integer"
                    },
                    "intensity_evidence": {
                      "type": "string"
                    },
                    "priority_score": {
                      "type": "integer"
                    },
                    "priority_level": {
                      "type": "string"
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    }
                  }
                }
              }
            }
          },
          "portrait_features": {
            "type": "object",
            "required": [
              "emotion_stability",
              "emotion_risk",
              "protagonist_feature_focus",
              "participant_feature_focus",
              "achievement_attention",
              "health_attention"
            ],
            "properties": {
              "emotion_stability": {
                "type": "number"
              },
              "emotion_risk": {
                "type": "number"
              },
              "protagonist_feature_focus": {
                "type": "number"
              },
              "participant_feature_focus": {
                "type": "number"
              },
              "achievement_attention": {
                "type": "number"
              },
              "health_attention": {
                "type": "number"
              }
            }
          },
          "proposal_view": {
            "type": "object",
            "required": [
              "event_elements",
              "core_dimensions"
            ],
            "properties": {
              "event_elements": {
                "type": "object",
                "required": [
                  "time_mentions",
                  "subject_mentions",
                  "events"
                ],
                "properties": {
                  "time_mentions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "time_spans": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "text",
                        "start",
                        "end",
                        "normalized",
                        "kind"
                      ],
                      "properties": {
                        "text": {
                          "type": "string"
                        },
                        "start": {
                          "type": "integer"
                        },
                        "end": {
                          "type": "integer"
                        },
                        "normalized": {
                          "type": "string"
                        },
                        "kind": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "subject_mentions": {
                    "type": "object",
                    "required": [
                      "protagonist",
                      "participant"
                    ],
                    "properties": {
                      "protagonist": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "participant": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "subject_mentions_normalized": {
                    "type": "object",
                    "required": [
                      "protagonist",
                      "participant"
                    ],
                    "properties": {
                      "protagonist": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "participant": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "events": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "type",
                        "text",
                        "start",
                        "end",
                        "dimension"
                      ],
                      "properties": {
                        "type": {
                          "type": "string"
                        },
                        "text": {
                          "type": "string"
                        },
                        "normalized_text": {
                          "type": "string"
                        },
                        "time_text": {
                          "type": "string"
                        },
                        "time_normalized": {
                          "type": "string"
                        },
                        "time_kind": {
                          "type": "string"
                        },
                        "frequency": {
                          "type": "string"
                        },
                        "frequency_score": {
                          "type": "integer"
                        },
                        "frequency_evidence": {
                          "type": "string"
                        },
                        "intensity": {
                          "type": "string"
                        },
                        "intensity_score": {
                          "type": "integer"
                        },
                        "intensity_evidence": {
                          "type": "string"
                        },
                        "priority_score": {
                          "type": "integer"
                        },
                        "priority_level": {
                          "type": "string"
                        },
                        "start": {
                          "type": "integer"
                        },
                        "end": {
                          "type": "integer"
                        },
                        "dimension": {
                          "type": "string",
                          "enum": [
                            "health",
                            "social",
                            "profile"
                          ]
                        }
                      }
                    }
                  },
                  "event_triplets": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "event_type",
                        "when",
                        "who",
                        "what",
                        "dimension",
                        "start",
                        "end"
                      ],
                      "properties": {
                        "event_type": {
                          "type": "string"
                        },
                        "when": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "time_text": {
                          "type": "string"
                        },
                        "time_normalized": {
                          "type": "string"
                        },
                        "time_kind": {
                          "type": "string"
                        },
                        "who": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "who_normalized": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "what": {
                          "type": "string"
                        },
                        "what_normalized": {
                          "type": "string"
                        },
                        "frequency": {
                          "type": "string"
                        },
                        "frequency_score": {
                          "type": "integer"
                        },
                        "intensity": {
                          "type": "string"
                        },
                        "intensity_score": {
                          "type": "integer"
                        },
                        "priority_score": {
                          "type": "integer"
                        },
                        "priority_level": {
                          "type": "string"
                        },
                        "dimension": {
                          "type": "string"
                        },
                        "start": {
                          "type": "integer"
                        },
                        "end": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "timeline": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "order",
                        "when",
                        "who",
                        "what",
                        "event_type",
                        "dimension"
                      ],
                      "properties": {
                        "order": {
                          "type": "integer"
                        },
                        "when": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "time_text": {
                          "type": "string"
                        },
                        "time_normalized": {
                          "type": "string"
                        },
                        "time_kind": {
                          "type": "string"
                        },
                        "who": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "who_normalized": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "what": {
                          "type": "string"
                        },
                        "what_normalized": {
                          "type": "string"
                        },
                        "frequency": {
                          "type": "string"
                        },
                        "frequency_score": {
                          "type": "integer"
                        },
                        "intensity": {
                          "type": "string"
                        },
                        "intensity_score": {
                          "type": "integer"
                        },
                        "priority_score": {
                          "type": "integer"
                        },
                        "priority_level": {
                          "type": "string"
                        },
                        "event_type": {
                          "type": "string"
                        },
                        "dimension": {
                          "type": "string"
                        },
                        "timeline_bucket": {
                          "type": "integer"
                        },
                        "timeline_value": {
                          "type": "integer"
                        },
                        "order_sorted": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  "timeline_sorted": {
                    "type": "array",
                    "items": {
                      "$ref": "#/properties/results/items/properties/proposal_view/properties/event_elements/properties/timeline/items"
                    }
                  },
                  "timeline_sort_order": {
                    "type": "string"
                  },
                  "entity_mentions_by_type_normalized": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "frequency_summary": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer"
                    }
                  },
                  "intensity_summary": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer"
                    }
                  },
                  "priority_summary": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "integer"
                    }
                  }
                }
              },
              "core_dimensions": {
                "type": "object",
                "required": [
                  "health",
                  "emotion",
                  "social"
                ],
                "properties": {
                  "health": {
                    "type": "object",
                    "required": [
                      "score",
                      "evidence_count"
                    ],
                    "properties": {
                      "score": {
                        "type": "number"
                      },
                      "evidence_count": {
                        "type": "integer"
                      }
                    }
                  },
                  "emotion": {
                    "type": "object",
                    "required": [
                      "label",
                      "score",
                      "confidence"
                    ],
                    "properties": {
                      "label": {
                        "type": "string"
                      },
                      "score": {
                        "type": "number"
                      },
                      "confidence": {
                        "type": "number"
                      }
                    }
                  },
                  "social": {
                    "type": "object",
                    "required": [
                      "score",
                      "evidence_count"
                    ],
                    "properties": {
                      "score": {
                        "type": "number"
                      },
                      "evidence_count": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
